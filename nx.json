{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "plugins": [
    {
      "plugin": "nx/plugins/package-json",
      "exclude": ["packages/clients/diplan/vendored/**"]
    }
  ],
  "defaultBase": "main",
  "release": {
    "projectsRelationship": "independent",
    "version": {
      "updateDependents": "auto"
    }
  },
  "analytics": false,
  "neverConnectToCloud": true
}
